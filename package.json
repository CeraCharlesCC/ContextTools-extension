{
  "name": "context-tools-extension",
  "version": "0.3.1",
  "description": "Copy GitHub context into markdown.",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:chrome",
    "dev:chrome": "node scripts/dev.mjs chrome",
    "dev:firefox": "node scripts/dev.mjs firefox",
    "build": "npm run build:chrome && npm run build:firefox",
    "build:chrome": "cross-env TARGET_BROWSER=chrome VITE_BUILD_TARGET=main vite build && cross-env TARGET_BROWSER=chrome VITE_BUILD_TARGET=content vite build",
    "build:firefox": "cross-env TARGET_BROWSER=firefox VITE_BUILD_TARGET=main vite build && cross-env TARGET_BROWSER=firefox VITE_BUILD_TARGET=content vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "sync:versions": "node scripts/sync-versions.mjs",
    "sync:versions:check": "node scripts/sync-versions.mjs --check",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "clean": "node scripts/clean.mjs"
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^25.0.10",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": "^18.18.0 || ^20.9.0 || >=22.0.0"
  }
}
